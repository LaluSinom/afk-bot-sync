# Bisa Ditamnbah jumlah botnya tinggal Copy Paste dan ganti nomor botnya

# Pengaturan Default untuk Semua Bot
DEFAULT_VOICE_CHANNEL_ID=123456789012345678
DEFAULT_GAME=Nama Aktifitas

# Bot Kloningan 1 (Aktif)
BOT_1_ACTIVE=true
BOT_1_NAME=Member Pertama
BOT_1_TOKEN=MASUKKAN_TOKEN_BOT_1_DI_SINI
BOT_1_USER_ID=111111111111111111

# Bot Kloningan 2 (Nonaktif sementara - ubah ke true untuk menyalakan)
BOT_2_ACTIVE=false
BOT_2_NAME=Member Kedua
BOT_2_TOKEN=MASUKKAN_TOKEN_BOT_2_DI_SINI
BOT_2_USER_ID=222222222222222222

# Opsional: Gunakan channel atau status game berbeda untuk bot tertentu
# BOT_2_VOICE_ID=987654321098765432
# BOT_2_GAME=Minecraft
